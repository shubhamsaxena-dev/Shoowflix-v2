generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  email              String?             @unique
  name               String?             @map("first_name")
  lastName           String?             @map("last_name")
  userName           String?             @unique
  password           String?             // For email/password authentication
  emailVerified      DateTime?
  image              String?             @map("profile_image_url")
  hasAccess          Boolean?            @map("has_access")
  inviteCode         String?             @map("invite_code")

  accounts           Account[]
  sessions           Session[]
  userFeaturedMovies UserFeaturedMovies?
  comments           Comments[]
  notifications      Notification[]

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserFeaturedMovies {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @unique
  movieIds String[]

  user     User     @relation(fields: [userId], references: [id])
}

model Comments {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  parentId    String?
  userId      String
  text        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  upVotes     Int?          @default(0)
  downVotes   Int?          @default(0)
  movieId     String

  commentedBy User          @relation(fields: [userId], references: [id])
  notifications Notification[]
}

model Notification {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  type      String
  message   String
  commentId String?
  createdAt DateTime   @default(now())
  seen      Boolean    @default(false)

  user      User       @relation(fields: [userId], references: [id])
  comment   Comments?  @relation(fields: [commentId], references: [id])
}

model Subscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
