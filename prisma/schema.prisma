generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  email              String?             @unique
  name               String?             @map("first_name")
  lastName           String?             @map("last_name")
  userName           String?             @unique
  password           String?             // For email/password authentication
  emailVerified      DateTime?
  image              String?             @map("profile_image_url")
  hasAccess          Boolean?            @map("has_access")
  inviteCode         String?             @map("invite_code")

  accounts           Account[]
  sessions           Session[]
  userFeaturedMovies UserFeaturedMovies?
  comments           Comments[]
  notifications      Notification[]

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model UserFeaturedMovies {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String   @unique
  movieIds String[]

  user     User     @relation(fields: [userId], references: [id])
}

model Comments {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  parentId    String?
  userId      String
  text        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  upVotes     Int?          @default(0)
  downVotes   Int?          @default(0)
  movieId     String

  commentedBy User          @relation(fields: [userId], references: [id])
  notifications Notification[]
}

model Notification {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  type      String
  message   String
  commentId String?
  createdAt DateTime   @default(now())
  seen      Boolean    @default(false)

  user      User       @relation(fields: [userId], references: [id])
  comment   Comments?  @relation(fields: [commentId], references: [id])
}

model Subscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Per-user playback progress for "Continue watching" (synced from the player).
model WatchProgress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  movieId   Int
  quality   String?
  position  Float    // seconds
  duration  Float    // seconds
  title     String
  poster    String?
  backdrop  String?
  updatedAt DateTime @updatedAt

  @@unique([userId, movieId])
  @@index([userId, updatedAt])
}

/// What a movie card needs, saved when a film is added to a list, so My List renders from
/// one database query instead of one YTS request per film. Refreshed on every add.
model MovieSnapshot {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  movieId     Int      @unique
  title       String
  year        Int
  runtime     Int      @default(0)
  rating      Float    @default(0)
  genres      String[]
  poster      String   @default("")
  posterLarge String   @default("")
  updatedAt   DateTime @updatedAt

  @@map("movie_snapshots")
}

/// One live password-reset code per email. Only the SHA-256 of the code is stored.
/// Expired rows are swept by a TTL index on expires_at (scripts/create-otp-ttl-index.mjs).
model PasswordResetOtp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  codeHash  String   @map("code_hash")
  /// Set once the code is verified; the code is then spent and only this token can reset.
  resetTokenHash String? @map("reset_token_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_otps")
}

/// One row per reset-code request, for the "5 codes per account per 24 h" limit.
/// Rows delete themselves after 24 h via a TTL index on created_at (scripts/create-otp-ttl-index.mjs).
model PasswordResetRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("password_reset_requests")
}

/// One row per user per UTC day they asked "Ask the projectionist" (limit: 1 a day).
/// The unique index makes the check-and-spend atomic. Rows delete themselves after 48 h via a
/// TTL index on created_at (scripts/create-otp-ttl-index.mjs).
model AiSuggestUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id")
  day       String   // YYYY-MM-DD, UTC
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, day])
  @@map("ai_suggest_usage")
}
