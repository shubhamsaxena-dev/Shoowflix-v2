{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/movies/[id]",
      "regex": "^/api/movies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/movies/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/movies/[id]/suggestions",
      "regex": "^/api/movies/([^/]+?)/suggestions(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/movies/(?<nxtPid>[^/]+?)/suggestions(?:/)?$"
    },
    {
      "page": "/genre/[genre]",
      "regex": "^/genre/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPgenre": "nxtPgenre"
      },
      "namedRegex": "^/genre/(?<nxtPgenre>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movie/[id]",
      "regex": "^/movie/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/movie/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movie/[id]/[slug]",
      "regex": "^/movie/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/movie/(?<nxtPid>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/genre",
      "regex": "^/genre(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/genre(?:/)?$"
    },
    {
      "page": "/home",
      "regex": "^/home(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/home(?:/)?$"
    },
    {
      "page": "/movie-detail",
      "regex": "^/movie\\-detail(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/movie\\-detail(?:/)?$"
    },
    {
      "page": "/not-found",
      "regex": "^/not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/not\\-found(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}