# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Prisma)
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/shoowflix"

# NextAuth: site URL and a long random secret (also signs the disclaimer cookie)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# YTS API root
NEXT_PUBLIC_API_ROOT="https://yts.gg/api/v2"

# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: AI picks use OpenAI when set, a keyword heuristic otherwise
OPENAI_API_KEY=""
OPENAI_MODEL=""
